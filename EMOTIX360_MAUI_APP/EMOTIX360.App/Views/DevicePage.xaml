<?xml version="1.0" encoding="UTF-8" ?>

<ContentPage
    x:Class="EMOTIX360.App.Views.DevicePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Device"
    BackgroundColor="#0B111B"
    Shell.NavBarIsVisible="False">

    <!--
        DEVICE PAGE STRUCTURE

        Grid
        ├── Header
        ├── Connection status
        ├── Discovery section (Grid)
        │    ├── Discovered devices heading
        │    ├── CollectionView
        │    │    └── EmptyView
        │    ├── Connect button
        │    └── Disconnect button
        └── Footer information

        PERFORMANCE:
        - No outer ScrollView wrapping the CollectionView.
        - The CollectionView occupies the available remaining space.
        - The CollectionView handles its own scrolling.
        - Grid-based layout avoids measuring a nested scrollable list
          inside a VerticalStackLayout.
    -->

    <Grid
        Padding="22,26,22,30"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="20">

        <!-- ===================================================== -->
        <!-- 1. PAGE HEADER                                        -->
        <!-- ===================================================== -->

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="5">

            <Label
                Text="DEVICE"
                FontSize="11"
                CharacterSpacing="2"
                FontAttributes="Bold"
                TextColor="#5796FF" />

            <Label
                Text="Bluetooth"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="#F2F5FC" />

            <Label
                Text="Discover and connect to your EMOTIX360 display."
                FontSize="14"
                TextColor="#8999AF" />

        </VerticalStackLayout>


        <!-- ===================================================== -->
        <!-- 2. CONNECTION STATUS SECTION                          -->
        <!-- ===================================================== -->

        <Border
            Grid.Row="1"
            BackgroundColor="#142135"
            Stroke="#263C58"
            StrokeThickness="1"
            Padding="19">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="10">

                <!-- Connection section heading -->

                <Grid ColumnDefinitions="*,Auto">

                    <Label
                        Text="CONNECTION STATUS"
                        FontSize="11"
                        CharacterSpacing="1.2"
                        FontAttributes="Bold"
                        TextColor="#91A4BF" />

                    <Label
                        Grid.Column="1"
                        Text="BLE"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#5796FF" />

                </Grid>


                <!-- Current connection state -->

                <Label
                    Text="{Binding ConnectionText}"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="#F2F5FC" />


                <!-- Connection information and feedback -->

                <Label
                    Text="{Binding StatusMessage}"
                    FontSize="13"
                    TextColor="#9BAAC0"
                    LineBreakMode="WordWrap" />


                <!-- Start Bluetooth device discovery -->

                <Button
                    Text="{Binding ScanButtonText}"
                    Command="{Binding ScanCommand}"
                    IsEnabled="{Binding CanScan}"
                    BackgroundColor="#397FE8"
                    TextColor="White"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    FontSize="13"
                    HeightRequest="50"
                    CornerRadius="14" />

            </VerticalStackLayout>

        </Border>


        <!-- ===================================================== -->
        <!-- 3. DEVICE DISCOVERY SECTION                           -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="2"
            RowDefinitions="Auto,*,Auto,Auto"
            RowSpacing="11">

            <!-- Discovered devices heading -->

            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto">

                <Label
                    Text="DISCOVERED DEVICES"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    TextColor="#DFE7F3" />

                <Label
                    Grid.Column="1"
                    Text="EMOTIX360"
                    FontSize="10"
                    TextColor="#7789A3" />

            </Grid>


            <!--
                Bluetooth discovery results

                IMPORTANT:
                This CollectionView is placed directly inside a Grid.
                It receives the remaining available vertical space.

                It handles its own scrolling, so an outer ScrollView
                or fixed HeightRequest is not required.
            -->

            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding Devices}"
                SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                SelectionMode="Single"
                VerticalOptions="Fill">

                <!-- Displayed when no supported devices are discovered -->

                <CollectionView.EmptyView>

                    <Border
                        BackgroundColor="#121C2B"
                        Stroke="#26364A"
                        Padding="16">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Label
                            Text="Tap SCAN FOR EMOTIX360 to search for your ESP32-S3."
                            TextColor="#8999AF"
                            FontSize="12" />

                    </Border>

                </CollectionView.EmptyView>


                <!-- Individual discovered device item -->

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            BackgroundColor="#121C2B"
                            Stroke="#26364A"
                            StrokeThickness="1"
                            Padding="15"
                            Margin="0,4">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="*,Auto">

                                <!-- Device identification -->

                                <VerticalStackLayout Spacing="4">

                                    <Label
                                        Text="{Binding Name}"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="#F2F5FC" />

                                    <Label
                                        Text="ESP32-S3 Bluetooth LE device"
                                        FontSize="11"
                                        TextColor="#8999AF" />

                                </VerticalStackLayout>


                                <!-- Bluetooth signal strength -->

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding SignalText}"
                                    FontSize="10"
                                    TextColor="#78A8FF"
                                    VerticalOptions="Center" />

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>


            <!-- Connect to the selected device -->

            <Button
                Grid.Row="2"
                Text="CONNECT SELECTED DEVICE"
                Command="{Binding ConnectSelectedCommand}"
                IsEnabled="{Binding CanConnectSelected}"
                BackgroundColor="#397FE8"
                TextColor="White"
                FontAttributes="Bold"
                CharacterSpacing="0.8"
                FontSize="12"
                HeightRequest="49"
                CornerRadius="14" />


            <!-- Disconnect the currently connected device -->

            <Button
                Grid.Row="3"
                Text="DISCONNECT"
                Command="{Binding DisconnectCommand}"
                IsVisible="{Binding IsConnected}"
                BackgroundColor="#3A2029"
                TextColor="#FFB8C2"
                FontAttributes="Bold"
                FontSize="12"
                HeightRequest="46"
                CornerRadius="14" />

        </Grid>


        <!-- ===================================================== -->
        <!-- 4. FOOTER INFORMATION                                 -->
        <!-- ===================================================== -->

        <Label
            Grid.Row="3"
            Text="Keep EMOTIX360 powered on and within Bluetooth range while connecting."
            FontSize="11"
            TextColor="#677B94"
            HorizontalTextAlignment="Center" />

    </Grid>

</ContentPage>