<?xml version="1.0" encoding="UTF-8" ?>

<ContentPage
    x:Class="EMOTIX360.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Settings"
    BackgroundColor="#0B111B"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="22,26,22,30"
            Spacing="22">

            <VerticalStackLayout Spacing="5">

                <Label
                    Text="PREFERENCES"
                    FontSize="11"
                    CharacterSpacing="2"
                    FontAttributes="Bold"
                    TextColor="#5796FF" />

                <Label
                    Text="Settings"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="#F2F5FC" />

                <Label
                    Text="Configure your EMOTIX360 application."
                    FontSize="14"
                    TextColor="#8999AF" />

            </VerticalStackLayout>


            <!-- APPEARANCE -->
            <VerticalStackLayout Spacing="12">

                <Label
                    Text="APPEARANCE"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    TextColor="#DFE7F3" />

                <Border
                    BackgroundColor="#121C2B"
                    Stroke="#26364A"
                    StrokeThickness="1"
                    Padding="17">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="Application theme"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#F2F5FC" />

                            <Label
                                Text="EMOTIX360 dark appearance"
                                FontSize="11"
                                TextColor="#8999AF" />

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="DARK"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="#78A8FF"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

            </VerticalStackLayout>


            <!-- DEVICE INFORMATION -->
            <VerticalStackLayout Spacing="12">

                <Label
                    Text="DEVICE"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    TextColor="#DFE7F3" />

                <Border
                    BackgroundColor="#121C2B"
                    Stroke="#26364A"
                    StrokeThickness="1"
                    Padding="17">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="16">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Device name"
                                FontSize="13"
                                TextColor="#93A4BA" />

                            <Label
                                Grid.Column="1"
                                Text="EMOTIX360"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#F2F5FC" />

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="#26364A" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Hardware"
                                FontSize="13"
                                TextColor="#93A4BA" />

                            <Label
                                Grid.Column="1"
                                Text="ESP32-S3"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#F2F5FC" />

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="#26364A" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Connection"
                                FontSize="13"
                                TextColor="#93A4BA" />

                            <Label
                                Grid.Column="1"
                                Text="Bluetooth LE"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#F2F5FC" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>


            <!-- WIFI PROVISIONING -->
            <VerticalStackLayout Spacing="12">

                <Label
                    Text="WI-FI CONFIGURATION"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    TextColor="#DFE7F3" />

                            <Border
                    BackgroundColor="#121C2B"
                    Stroke="#26364A"
                    StrokeThickness="1"
                    Padding="17">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="15">

                        <!-- DEVICE CONNECTION -->

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                    Text="EMOTIX360 connection"
                    FontSize="13"
                    TextColor="#93A4BA"
                    VerticalOptions="Center" />

                            <Label
                    Grid.Column="1"
                    Text="{Binding ConnectionText}"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="#78A8FF"
                    VerticalOptions="Center" />

                        </Grid>

                        <BoxView
                HeightRequest="1"
                Color="#26364A" />

                        <!-- PHONE WIFI -->

                        <VerticalStackLayout Spacing="7">

                            <Label
                    Text="PHONE'S CONNECTED WI-FI"
                    FontSize="11"
                    FontAttributes="Bold"
                    CharacterSpacing="0.5"
                    TextColor="#93A4BA" />

                            <Label
                    Text="{Binding CurrentPhoneSsidText}"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#F2F5FC" />

                            <Button
                    Text="REFRESH PHONE WI-FI"
                    Command="{Binding RefreshPhoneSsidCommand}"
                    BackgroundColor="#1C2B40"
                    TextColor="#A9C8FF"
                    FontSize="11"
                    CornerRadius="10" />

                            <Button
                    Text="USE THIS NETWORK"
                    Command="{Binding UsePhoneSsidCommand}"
                    IsEnabled="{Binding CanUsePhoneSsid}"
                    BackgroundColor="#1C2B40"
                    TextColor="#A9C8FF"
                    FontSize="11"
                    CornerRadius="10" />

                            <Label
                    Text="Android may request location access to reveal the connected network name. The Wi-Fi password cannot be read from the phone."
                    FontSize="10"
                    TextColor="#71839B" />

                        </VerticalStackLayout>

                        <BoxView
                HeightRequest="1"
                Color="#26364A" />

                        <!-- MANUAL CREDENTIALS -->

                        <VerticalStackLayout Spacing="8">

                            <Label
                    Text="NETWORK NAME (SSID)"
                    FontSize="11"
                    FontAttributes="Bold"
                    TextColor="#93A4BA" />

                            <Entry
                    Text="{Binding Ssid}"
                    Placeholder="Enter Wi-Fi network name"
                    PlaceholderColor="#64758C"
                    TextColor="#F2F5FC"
                    BackgroundColor="#0B111B"
                    ClearButtonVisibility="WhileEditing" />

                            <Label
                    Text="WI-FI PASSWORD"
                    FontSize="11"
                    FontAttributes="Bold"
                    TextColor="#93A4BA"
                    Margin="0,8,0,0" />

                            <Entry
                    Text="{Binding Password}"
                    Placeholder="Enter Wi-Fi password"
                    PlaceholderColor="#64758C"
                    TextColor="#F2F5FC"
                    BackgroundColor="#0B111B"
                    IsPassword="True"
                    ClearButtonVisibility="WhileEditing" />

                            <Label
                    Text="Leave the password empty only for an open Wi-Fi network. WPA passwords must contain 8–63 UTF-8 bytes."
                    FontSize="10"
                    TextColor="#71839B" />

                        </VerticalStackLayout>

                        <BoxView
                HeightRequest="1"
                Color="#26364A" />

                        <!-- STORED NETWORK COUNT -->

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                    Text="Saved app-sent networks"
                    FontSize="13"
                    TextColor="#93A4BA"
                    VerticalOptions="Center" />

                            <Label
                    Grid.Column="1"
                    Text="{Binding StoredNetworkCountText}"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="#F2F5FC"
                    VerticalOptions="Center" />

                        </Grid>

                        <Label
                Text="Maximum 8 networks. A new distinct network replaces the oldest entry when storage is full."
                FontSize="10"
                TextColor="#71839B" />

                        <!-- SEND CREDENTIALS -->

                        <Button
                Text="SEND WI-FI CREDENTIALS"
                Command="{Binding SendCredentialsCommand}"
                IsEnabled="{Binding CanSendCredentials}"
                BackgroundColor="#2463EB"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="12"
                CornerRadius="12"
                HeightRequest="48" />

                        <!-- CLEAR CREDENTIALS -->

                        <Button
                Text="CLEAR APP-SENT NETWORKS"
                Command="{Binding ClearStoredNetworksCommand}"
                IsEnabled="{Binding CanClearStoredNetworks}"
                BackgroundColor="#38202A"
                TextColor="#FF9DAA"
                FontAttributes="Bold"
                FontSize="11"
                CornerRadius="12"
                HeightRequest="44" />

                        <!-- OPERATION STATUS -->

                        <Border
                BackgroundColor="#0B111B"
                Stroke="#26364A"
                StrokeThickness="1"
                Padding="12">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <Label
                    Text="{Binding StatusMessage}"
                    FontSize="11"
                    TextColor="#A9BBD1" />

                        </Border>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>
            
            <!-- APPLICATION INFORMATION -->
            <VerticalStackLayout Spacing="12">

                <Label
                    Text="APPLICATION"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    TextColor="#DFE7F3" />

                <Border
                    BackgroundColor="#121C2B"
                    Stroke="#26364A"
                    StrokeThickness="1"
                    Padding="17">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="13">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Application"
                                FontSize="13"
                                TextColor="#93A4BA" />

                            <Label
                                Grid.Column="1"
                                Text="EMOTIX360"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#F2F5FC" />

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="#26364A" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Version"
                                FontSize="13"
                                TextColor="#93A4BA" />

                            <Label
                                Grid.Column="1"
                                Text="1.0"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#F2F5FC" />

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="#26364A" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Platform"
                                FontSize="13"
                                TextColor="#93A4BA" />

                            <Label
                                Grid.Column="1"
                                Text="Android"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#F2F5FC" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>


            <!-- FOOTER -->
            <VerticalStackLayout
                Spacing="5"
                HorizontalOptions="Center"
                Margin="0,10,0,0">

                <Label
                    Text="EMOTIX360"
                    FontSize="13"
                    FontAttributes="Bold"
                    CharacterSpacing="2"
                    TextColor="#60748F"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Designed for intelligent interaction."
                    FontSize="10"
                    TextColor="#53657C"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
