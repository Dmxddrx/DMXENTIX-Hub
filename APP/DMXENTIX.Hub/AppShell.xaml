<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="DMXENTIX.Hub.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="True"
    Shell.TabBarBackgroundColor="#101A29"
    Shell.TabBarForegroundColor="#5796FF"
    Shell.TabBarUnselectedColor="#8999AF">

    <TabBar>

        <ShellContent
            x:Name="HomeShellContent"
            Title="Home"
            Route="home" />

        <ShellContent
            x:Name="SettingsShellContent"
            Title="Settings"
            Route="settings" />

    </TabBar>

</Shell>