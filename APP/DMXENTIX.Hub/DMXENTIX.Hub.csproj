<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>

    <RootNamespace>DMXENTIX.Hub</RootNamespace>
    <AssemblyName>DMXENTIX.Hub</AssemblyName>

    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>DMXENTIX Hub</ApplicationTitle>
    <ApplicationId>com.dmxddrx.emotix360</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
</PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
	<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.15" />

    <MauiIcon Include="Resources\AppIcon\appicon.svg" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B111B" BaseSize="256,256" />

    <MauiXaml Update="App.xaml" Generator="MSBuild:Compile" />
    <MauiXaml Update="AppShell.xaml" Generator="MSBuild:Compile" />
    <MauiXaml Update="MainPage.xaml" Generator="MSBuild:Compile" />
    <MauiXaml Update="Views\DevicePage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\DeviceHubPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\DeviceWorkspacePage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Emotix360DashboardView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\SoundNodeDashboardView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Emotix360WifiProvisioningView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\HomePage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\MyDevicesPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\SettingsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <PackageReference Include="Plugin.BLE" Version="3.3.0-beta.3" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\Images\" />
    <Folder Include="Resources\Fonts\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\DeviceHubPage.xaml.cs">
      <DependentUpon>DeviceHubPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Emotix360DashboardView.xaml.cs">
      <DependentUpon>Emotix360DashboardView.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\SoundNodeDashboardView.xaml.cs">
      <DependentUpon>SoundNodeDashboardView.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
