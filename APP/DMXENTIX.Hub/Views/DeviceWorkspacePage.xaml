<?xml version="1.0" encoding="UTF-8" ?>

<ContentPage
    x:Class="DMXENTIX.Hub.Views.DeviceWorkspacePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DMXENTIX.Hub.Views"
    Title="Device Workspace"
    BackgroundColor="#0B111B"
    Shell.NavBarIsVisible="False">

    <Grid>

        <ScrollView x:Name="WorkspaceContent">

            <VerticalStackLayout
            Padding="22,26,22,30"
            Spacing="20">

                <!-- ================================================= -->
                <!-- HEADER                                            -->
                <!-- ================================================= -->

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="5">

                        <Label
                            Text="DEVICE WORKSPACE"
                            FontSize="11"
                            CharacterSpacing="2"
                            FontAttributes="Bold"
                            TextColor="#5796FF" />

                        <Label
                            Text="{Binding DisplayName}"
                            FontSize="30"
                            FontAttributes="Bold"
                            TextColor="#F2F5FC" />

                        <Label
                            Text="{Binding DeviceTypeText}"
                            FontSize="11"
                            CharacterSpacing="1"
                            FontAttributes="Bold"
                            TextColor="#78A8FF" />

                    </VerticalStackLayout>

                    <!-- DEVICE INFORMATION BUTTON -->

                    <Button
                        Grid.Column="1"
                        Text="INFO"
                        Clicked="OnShowInfoClicked"
                        BackgroundColor="#263C58"
                        TextColor="#C0D7FA"
                        FontSize="10"
                        FontAttributes="Bold"
                        Padding="14,9"
                        CornerRadius="9"
                        IsVisible="{Binding HasRecord}"
                        VerticalOptions="Start" />

                </Grid>


            <!-- ================================================= -->
            <!-- CONNECTION STATUS                                 -->
            <!-- ================================================= -->

            <Border
                BackgroundColor="#142135"
                Stroke="#263C58"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="17" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="DEVICE CONNECTION"
                        FontSize="11"
                        CharacterSpacing="1.2"
                        FontAttributes="Bold"
                        TextColor="#91A4BF" />

                    <Label
                        Text="{Binding ConnectionStatusText}"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#F2F5FC" />

                    <Label
                        Text="{Binding StatusMessage}"
                        FontSize="12"
                        TextColor="#C0CCDD"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

            </Border>


            <!-- ================================================= -->
            <!-- WORKSPACE CONTENT                                 -->
            <!-- ================================================= -->

            <Border
                IsVisible="{Binding IsWorkspaceMessageVisible}"
                BackgroundColor="#142135"
                Stroke="#263C58"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="17" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="WORKSPACE"
                        FontSize="11"
                        CharacterSpacing="1.2"
                        FontAttributes="Bold"
                        TextColor="#91A4BF" />

                    <Label
                        Text="{Binding WorkspaceMessage}"
                        FontSize="13"
                        TextColor="#C0CCDD"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

            </Border>

            <!-- ================================================= -->
            <!-- EMOTIX360 DASHBOARD                               -->
            <!-- ================================================= -->

            <VerticalStackLayout
                IsVisible="{Binding IsDashboardVisible}"
                Spacing="0">

                <views:Emotix360DashboardView
                    x:Name="Emotix360Dashboard" />

            </VerticalStackLayout>

            <!-- ================================================= -->
            <!-- SOUNDNODE DASHBOARD                               -->
            <!-- ================================================= -->

                <VerticalStackLayout
                    IsVisible="{Binding IsSoundNodeDashboardVisible}"
                    Spacing="0">

                    <views:SoundNodeDashboardView
                        x:Name="SoundNodeDashboard" />

                </VerticalStackLayout>


                <!-- ================================================= -->
            <!-- FOOTER                                            -->
            <!-- ================================================= -->

            <Label
                Text="This workspace is associated with the selected saved device."
                FontSize="11"
                TextColor="#677B94"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

    </ScrollView>
        <!-- ================================================= -->
        <!-- EMOTIX360 WI-FI CONFIGURATION SCREEN              -->
        <!-- ================================================= -->

        <Grid
            x:Name="WifiConfigurationScreen"
            IsVisible="False"
            BackgroundColor="#0B111B">

            <ScrollView>

                <VerticalStackLayout
                    Padding="22,26,22,30"
                    Spacing="20">

                    <!-- PAGE HEADER -->

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="14">

                        <!-- CLOSE / BACK BUTTON -->

                        <Button
                            Text="←"
                            Clicked="OnCloseWifiConfigurationClicked"
                            BackgroundColor="#142135"
                            TextColor="#F2F5FC"
                            FontSize="24"
                            WidthRequest="46"
                            HeightRequest="46"
                            Padding="0"
                            CornerRadius="14"
                            VerticalOptions="Center" />

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="4"
                            VerticalOptions="Center">

                            <Label
                                Text="EMOTIX360"
                                FontSize="11"
                                CharacterSpacing="1.5"
                                FontAttributes="Bold"
                                TextColor="#5796FF" />

                            <Label
                                Text="Wi-Fi Configuration"
                                FontSize="23"
                                FontAttributes="Bold"
                                TextColor="#F2F5FC" />

                        </VerticalStackLayout>

                    </Grid>

                    <Label
                        Text="Manage the Wi-Fi network used by your EMOTIX360."
                        FontSize="13"
                        TextColor="#8999AF" />

                    <!-- EXISTING WI-FI PROVISIONING INTERFACE -->

                    <views:Emotix360WifiProvisioningView
                        x:Name="Emotix360WifiProvisioning" />

                </VerticalStackLayout>

            </ScrollView>

        </Grid>

        <!-- ================================================= -->
        <!-- DEVICE INFORMATION POPUP                          -->
        <!-- ================================================= -->

        <Grid
    x:Name="DeviceInfoPopup"
    IsVisible="False"
    ZIndex="20">

            <!-- DIMMED BACKGROUND -->

            <BoxView BackgroundColor="#C20B111B">

                <BoxView.GestureRecognizers>

                    <TapGestureRecognizer
                Tapped="OnInfoPopupBackgroundTapped" />

                </BoxView.GestureRecognizers>

            </BoxView>

            <!-- POPUP CARD -->

            <Border
        BackgroundColor="#142135"
        Stroke="#397FE8"
        StrokeThickness="1"
        Padding="19"
        Margin="24"
        MaximumWidthRequest="460"
        HorizontalOptions="Center"
        VerticalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="15">

                    <!-- POPUP HEADER -->

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="4">

                            <Label
                        Text="DEVICE INFORMATION"
                        FontSize="10"
                        CharacterSpacing="1.5"
                        FontAttributes="Bold"
                        TextColor="#5796FF" />

                            <Label
                        Text="{Binding DisplayName}"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#F2F5FC" />

                        </VerticalStackLayout>

                        <Button
                    Grid.Column="1"
                    Text="✕"
                    Clicked="OnCloseInfoPopupClicked"
                    BackgroundColor="#263C58"
                    TextColor="White"
                    FontSize="16"
                    Padding="10,5"
                    CornerRadius="9"
                    VerticalOptions="Start" />

                    </Grid>

                    <BoxView
                HeightRequest="1"
                Color="#263C58" />

                    <ScrollView MaximumHeightRequest="460">

                        <VerticalStackLayout Spacing="13">

                            <!-- CONNECTION -->

                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Text="Device Connection"
                                    FontSize="12"
                                    TextColor="#8999AF" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding ConnectionStatusText}"
                                    TextColor="{Binding ConnectionStatusColor}"
                                    FontSize="12"
                                    FontAttributes="Bold" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#263C58" />

                            <!-- DEVICE NAME -->

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="Device name"
                                    FontSize="10"
                                    TextColor="#8999AF" />

                                <Label
                                    Text="{Binding DisplayName}"
                                    FontSize="12"
                                    TextColor="#F2F5FC" />

                            </VerticalStackLayout>

                            <!-- BLUETOOTH NAME -->

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="Bluetooth advertised name"
                                    FontSize="10"
                                    TextColor="#8999AF" />

                                <Label
                                    Text="{Binding AdvertisedName}"
                                    FontSize="12"
                                    TextColor="#C0CCDD" />

                            </VerticalStackLayout>

                            <!-- LAST CONNECTION -->

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="Last connected"
                                    FontSize="10"
                                    TextColor="#8999AF" />

                                <Label
                                    Text="{Binding LastConnectedText}"
                                    FontSize="12"
                                    TextColor="#C0CCDD" />

                            </VerticalStackLayout>

                            <BoxView
                                HeightRequest="1"
                                Color="#263C58" />

                            <!-- REGISTRY ID -->

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="Registry ID"
                                    FontSize="10"
                                    TextColor="#8999AF" />

                                <Label
                                    Text="{Binding RegistryDeviceIdText}"
                                    FontSize="10"
                                    TextColor="#C0CCDD"
                                    LineBreakMode="CharacterWrap" />

                            </VerticalStackLayout>

                            <!-- BLUETOOTH TRANSPORT ID -->

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="Bluetooth transport ID"
                                    FontSize="10"
                                    TextColor="#8999AF" />

                                <Label
                                    Text="{Binding BluetoothDeviceIdText}"
                                    FontSize="10"
                                    TextColor="#C0CCDD"
                                    LineBreakMode="CharacterWrap" />

                            </VerticalStackLayout>

                            <!-- FIRMWARE AND PROTOCOL -->

                            <VerticalStackLayout
                                IsVisible="{Binding HasFirmwareInfo}"
                                Spacing="4">

                                <Label
                                    Text="Firmware / Protocol"
                                    FontSize="10"
                                    TextColor="#8999AF" />

                                <Label
                                    Text="{Binding FirmwareInfoText}"
                                    FontSize="11"
                                    TextColor="#C0CCDD" />

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </ScrollView>

                    <!-- CLOSE BUTTON -->

                    <Button
                        Text="CLOSE"
                        Clicked="OnCloseInfoPopupClicked"
                        BackgroundColor="#397FE8"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="45"
                        CornerRadius="11" />

                </VerticalStackLayout>

            </Border>

        </Grid>

    </Grid>

</ContentPage>