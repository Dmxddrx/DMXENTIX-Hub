<?xml version="1.0" encoding="UTF-8" ?>

<ContentView
    x:Class="DMXENTIX.Hub.Views.Emotix360DashboardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#0B111B">

    <!--
        HOME PAGE STRUCTURE

        ContentPage
        │
        ├─ Resources
        │  ├─ AnimationTileBorderStyle
        │  │  └─ DataTriggers for highlighted animation modes
        │  │
        │  └─ AnimationTileLabelStyle
        │     └─ DataTriggers for highlighted animation text
        │
        └─ ScrollView
           └─ VerticalStackLayout
              │
              ├─ Header
              │  ├─ Application name
              │  └─ BLE connection indicator
              │
              ├─ Welcome section
              │  ├─ Welcome heading
              │  └─ Description
              │
              ├─ Device connection card
              │  ├─ Connection information
              │  ├─ Connection description
              │  └─ Open Device page button
              │
              ├─ Device overview
              │  ├─ Overview heading and status
              │  ├─ Active mode card
              │  ├─ Brightness card
              │  ├─ Wi-Fi status card
              │  ├─ Motion sensor card
              │  └─ Brightness control
              │     ├─ Brightness slider
              │     └─ Apply brightness button
              │
              ├─ Animation modes
              │  ├─ Animation section heading
              │  ├─ Two-column animation grid
              │  │  ├─ IDLE
              │  │  ├─ SAND CLOCK
              │  │  ├─ WATER
              │  │  ├─ SAND GRAVITY
              │  │  ├─ HEART
              │  │  ├─ RAIN
              │  │  └─ WAVES
              │  └─ Dashboard status message
              │
              └─ Footer
                 ├─ Application name
                 └─ Application description

        NOTES:
- Resource styles control animation highlighting.
- Animation selection is handled through TapGestureRecognizers.
- Dashboard values are populated through ViewModel bindings.
- ScrollView handles scrolling for the complete dashboard.
    -->

    <!-- ============================================================ -->
    <!-- RESOURCES                                                    -->
    <!-- ============================================================ -->
    <ContentView.Resources>
        <ResourceDictionary>

            <!-- ── AnimationTileBorderStyle ────────────────────────── -->
            <Style
                x:Key="AnimationTileBorderStyle"
                TargetType="Border">

                <Setter Property="BackgroundColor" Value="#121C2B" />
                <Setter Property="Stroke" Value="#26364A" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="13" />

                <!-- DataTriggers for highlighted animation modes -->
                <Style.Triggers>

                    <!-- IDLE -->
                    <DataTrigger TargetType="Border" Binding="{Binding HighlightedModeKey}" Value="IDLE">
                        <Setter Property="BackgroundColor" Value="#17253A" />
                        <Setter Property="Stroke" Value="#5796FF" />
                    </DataTrigger>

                    <!-- SAND CLOCK -->
                    <DataTrigger TargetType="Border" Binding="{Binding HighlightedModeKey}" Value="SAND_CLOCK">
                        <Setter Property="BackgroundColor" Value="#17253A" />
                        <Setter Property="Stroke" Value="#5796FF" />
                    </DataTrigger>

                    <!-- WATER -->
                    <DataTrigger TargetType="Border" Binding="{Binding HighlightedModeKey}" Value="WATER">
                        <Setter Property="BackgroundColor" Value="#17253A" />
                        <Setter Property="Stroke" Value="#5796FF" />
                    </DataTrigger>

                    <!-- SAND GRAVITY -->
                    <DataTrigger TargetType="Border" Binding="{Binding HighlightedModeKey}" Value="SAND_GRAVITY">
                        <Setter Property="BackgroundColor" Value="#17253A" />
                        <Setter Property="Stroke" Value="#5796FF" />
                    </DataTrigger>

                    <!-- HEART -->
                    <DataTrigger TargetType="Border" Binding="{Binding HighlightedModeKey}" Value="HEART">
                        <Setter Property="BackgroundColor" Value="#17253A" />
                        <Setter Property="Stroke" Value="#5796FF" />
                    </DataTrigger>

                    <!-- RAIN -->
                    <DataTrigger TargetType="Border" Binding="{Binding HighlightedModeKey}" Value="RAIN">
                        <Setter Property="BackgroundColor" Value="#17253A" />
                        <Setter Property="Stroke" Value="#5796FF" />
                    </DataTrigger>

                    <!-- WAVES -->
                    <DataTrigger TargetType="Border" Binding="{Binding HighlightedModeKey}" Value="WAVES">
                        <Setter Property="BackgroundColor" Value="#17253A" />
                        <Setter Property="Stroke" Value="#5796FF" />
                    </DataTrigger>

                </Style.Triggers>
            </Style>


            <!-- ── AnimationTileLabelStyle ─────────────────────────── -->
            <Style
                x:Key="AnimationTileLabelStyle"
                TargetType="Label">

                <Setter Property="TextColor" Value="#C4D0E0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />

                <!-- DataTriggers for highlighted animation text -->
                <Style.Triggers>

                    <DataTrigger TargetType="Label" Binding="{Binding HighlightedModeKey}" Value="IDLE">
                        <Setter Property="TextColor" Value="#8EB6FF" />
                    </DataTrigger>

                    <DataTrigger TargetType="Label" Binding="{Binding HighlightedModeKey}" Value="SAND_CLOCK">
                        <Setter Property="TextColor" Value="#8EB6FF" />
                    </DataTrigger>

                    <DataTrigger TargetType="Label" Binding="{Binding HighlightedModeKey}" Value="WATER">
                        <Setter Property="TextColor" Value="#8EB6FF" />
                    </DataTrigger>

                    <DataTrigger TargetType="Label" Binding="{Binding HighlightedModeKey}" Value="SAND_GRAVITY">
                        <Setter Property="TextColor" Value="#8EB6FF" />
                    </DataTrigger>

                    <DataTrigger TargetType="Label" Binding="{Binding HighlightedModeKey}" Value="HEART">
                        <Setter Property="TextColor" Value="#8EB6FF" />
                    </DataTrigger>

                    <DataTrigger TargetType="Label" Binding="{Binding HighlightedModeKey}" Value="RAIN">
                        <Setter Property="TextColor" Value="#8EB6FF" />
                    </DataTrigger>

                    <DataTrigger TargetType="Label" Binding="{Binding HighlightedModeKey}" Value="WAVES">
                        <Setter Property="TextColor" Value="#8EB6FF" />
                    </DataTrigger>

                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>


    <!-- ============================================================ -->
    <!-- SCROLLVIEW (MAIN CONTENT)                                    -->
    <!-- ============================================================ -->

    <VerticalStackLayout
        Padding="22,26,22,30"
        Spacing="23">

        <!-- ======================================================== -->
        <!-- 1. HEADER                                                -->
        <!-- ======================================================== -->
        <Grid ColumnDefinitions="*,Auto">

            <!-- Application name -->
            <VerticalStackLayout Spacing="3">

                <Label
                    Text="EMOTIX360"
                    FontSize="21"
                    FontAttributes="Bold"
                    CharacterSpacing="2"
                    TextColor="#F2F5FC" />

                <Label
                    Text="INTERACTIVE DISPLAY CONTROL"
                    FontSize="10"
                    CharacterSpacing="1.5"
                    TextColor="#8291A8" />

            </VerticalStackLayout>

            <!-- BLE connection indicator -->
            <Border
                Grid.Column="1"
                BackgroundColor="#192638"
                Stroke="#293B52"
                StrokeThickness="1"
                Padding="12,8"
                VerticalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <HorizontalStackLayout
                    Spacing="7"
                    VerticalOptions="Center">

                    <Ellipse
                        WidthRequest="7"
                        HeightRequest="7"
                        Fill="{Binding ConnectionIndicatorColor}"
                        VerticalOptions="Center" />

                    <Label
                        Text="{Binding ConnectionText}"
                        FontSize="10"
                        FontAttributes="Bold"
                        CharacterSpacing="1"
                        TextColor="#D0DAE8"
                        VerticalOptions="Center" />

                </HorizontalStackLayout>

            </Border>

        </Grid>


        <!-- ======================================================== -->
        <!-- 2. WELCOME SECTION                                       -->
        <!-- ======================================================== -->
        <VerticalStackLayout Spacing="5">

            <!-- Welcome heading -->
            <Label
                Text="Your device."
                FontSize="32"
                FontAttributes="Bold"
                TextColor="#F2F5FC" />

            <Label
                Text="Your experience."
                FontSize="32"
                FontAttributes="Bold"
                TextColor="#5796FF" />

            <!-- Description -->
            <Label
                Text="Control and explore your EMOTIX360."
                FontSize="14"
                TextColor="#8999AF"
                Margin="0,5,0,0" />

        </VerticalStackLayout>


        <!-- ======================================================== -->
        <!-- 3. DEVICE CONNECTION CARD                                -->
        <!-- ======================================================== -->
        <Border
            x:Name="DeviceConnectionCard"
            BackgroundColor="#142135"
            Stroke="#263C58"
            StrokeThickness="1"
            Padding="19">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="15">

                <!-- Connection information -->
                <Grid ColumnDefinitions="*,Auto">

                    <Label
                        Text="DEVICE CONNECTION"
                        FontSize="11"
                        FontAttributes="Bold"
                        CharacterSpacing="1.5"
                        TextColor="#91A4BF"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Text="BLE"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#5796FF"
                        VerticalOptions="Center" />

                </Grid>

                <VerticalStackLayout Spacing="4">

                    <Label
                        Text="EMOTIX360"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="#F4F7FC" />

                    <Label
                        Text="{Binding ConnectionDescription}"
                        FontSize="14"
                        TextColor="#F2A65A" />

                </VerticalStackLayout>

                <!-- Connection description -->
                <Label
                    Text="Connect to your display to access animations, brightness and live device information."
                    FontSize="13"
                    TextColor="#9BAAC0"
                    LineHeight="1.35" />

                <!-- Open Device page button -->
                <Button
                    Text="{Binding ConnectButtonText}"
                    Command="{Binding OpenDeviceCommand}"
                    BackgroundColor="#397FE8"
                    TextColor="White"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    FontSize="13"
                    HeightRequest="52"
                    CornerRadius="14" />

            </VerticalStackLayout>

        </Border>


        <!-- ======================================================== -->
        <!-- 4. DEVICE OVERVIEW                                       -->
        <!-- ======================================================== -->
        <VerticalStackLayout Spacing="12">

            <!-- Overview heading and status -->
            <Grid ColumnDefinitions="*,Auto">

                <Label
                    Text="DEVICE OVERVIEW"
                    FontSize="13"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    TextColor="#E8EDF7" />

                <Label
                    Grid.Column="1"
                    Text="{Binding OverviewStatusText}"
                    FontSize="9"
                    CharacterSpacing="0.7"
                    TextColor="#7789A3"
                    VerticalOptions="Center" />

            </Grid>

            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="11"
                RowSpacing="11">

                <!-- ── Active mode card ──────────────────────────── -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="#121C2B"
                    Stroke="#233248"
                    StrokeThickness="1"
                    Padding="15">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="9">

                        <Label
                            Text="ACTIVE MODE"
                            FontSize="10"
                            CharacterSpacing="1"
                            TextColor="#8495AE" />

                        <Label
                            Text="{Binding ActiveModeText}"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="#5796FF" />

                        <Label
                            Text="Animation"
                            FontSize="11"
                            TextColor="#7789A3" />

                    </VerticalStackLayout>

                </Border>


                <!-- ── Brightness card ───────────────────────────── -->
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    BackgroundColor="#121C2B"
                    Stroke="#233248"
                    StrokeThickness="1"
                    Padding="15">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="9">

                        <Label
                            Text="BRIGHTNESS"
                            FontSize="10"
                            CharacterSpacing="1"
                            TextColor="#8495AE" />

                        <Label
                            Text="{Binding BrightnessText}"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="#E5BD70" />

                        <Label
                            Text="Matrix intensity"
                            FontSize="11"
                            TextColor="#7789A3" />

                    </VerticalStackLayout>

                </Border>


                <!-- ── Wi-Fi status card ─────────────────────────── -->
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    BackgroundColor="#121C2B"
                    Stroke="#233248"
                    StrokeThickness="1"
                    Padding="15">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="9">

                        <Label
                            Text="WI-FI"
                            FontSize="10"
                            CharacterSpacing="1"
                            TextColor="#8495AE" />

                        <Label
                            Text="{Binding WifiText}"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#72C9A0" />

                        <Label
                            Text="{Binding TimeText}"
                            FontSize="10"
                            TextColor="#7789A3" />

                    </VerticalStackLayout>

                </Border>


                <!-- ── Motion sensor card ────────────────────────── -->
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    BackgroundColor="#121C2B"
                    Stroke="#233248"
                    StrokeThickness="1"
                    Padding="15">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="9">

                        <Label
                            Text="MOTION SENSOR"
                            FontSize="10"
                            CharacterSpacing="1"
                            TextColor="#8495AE" />

                        <Label
                            Text="{Binding MotionText}"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#C49AFF" />

                        <Label
                            Text="MPU6050 status"
                            FontSize="11"
                            TextColor="#7789A3" />

                    </VerticalStackLayout>

                </Border>

            </Grid>


            <!-- ── Brightness control ────────────────────────────── -->
            <VerticalStackLayout Spacing="8" Margin="0,4,0,0">

                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Text="MATRIX BRIGHTNESS"
                        FontSize="10"
                        FontAttributes="Bold"
                        CharacterSpacing="1"
                        TextColor="#8495AE" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding BrightnessSliderText}"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#E5BD70" />
                </Grid>

                <!-- Brightness slider -->
                <Slider
                    Minimum="0"
                    Maximum="15"
                    Value="{Binding BrightnessValue, Mode=TwoWay}"
                    DragStartedCommand="{Binding BrightnessDragStartedCommand}"
                    DragCompletedCommand="{Binding BrightnessDragCompletedCommand}"
                    MinimumTrackColor="#5796FF"
                    MaximumTrackColor="#26364A"
                    ThumbColor="#F2F5FC" />

                <!-- Apply brightness button -->
                <Button
                    Text="APPLY BRIGHTNESS"
                    Command="{Binding ApplyBrightnessCommand}"
                    BackgroundColor="#263C58"
                    TextColor="#DDE9FF"
                    FontAttributes="Bold"
                    FontSize="11"
                    HeightRequest="44"
                    CornerRadius="12" />

            </VerticalStackLayout>

        </VerticalStackLayout>


        <!-- ======================================================== -->
        <!-- 5. ANIMATION MODES                                       -->
        <!-- ======================================================== -->
        <VerticalStackLayout Spacing="12">

            <!-- Animation section heading -->
            <Grid ColumnDefinitions="*,Auto">

                <Label
                    Text="ANIMATIONS"
                    FontSize="13"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    TextColor="#E8EDF7" />

                <Label
                    Grid.Column="1"
                    Text="7 MODES"
                    FontSize="10"
                    TextColor="#7789A3"
                    VerticalOptions="Center" />

            </Grid>

            <!-- ── Two-column animation grid ─────────────────────── -->
            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto,Auto"
                ColumnSpacing="10"
                RowSpacing="10">

                <!-- IDLE -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource AnimationTileBorderStyle}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="13" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding SelectAnimationCommand}"
                            CommandParameter="IDLE" />
                    </Border.GestureRecognizers>

                    <Label
                        Text="IDLE"
                        Style="{StaticResource AnimationTileLabelStyle}" />

                </Border>


                <!-- SAND CLOCK -->
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource AnimationTileBorderStyle}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="13" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding SelectAnimationCommand}"
                            CommandParameter="SAND_CLOCK" />
                    </Border.GestureRecognizers>

                    <Label
                        Text="SAND CLOCK"
                        Style="{StaticResource AnimationTileLabelStyle}" />

                </Border>


                <!-- WATER -->
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource AnimationTileBorderStyle}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="13" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding SelectAnimationCommand}"
                            CommandParameter="WATER" />
                    </Border.GestureRecognizers>

                    <Label
                        Text="WATER"
                        Style="{StaticResource AnimationTileLabelStyle}" />

                </Border>


                <!-- SAND GRAVITY -->
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource AnimationTileBorderStyle}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="13" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding SelectAnimationCommand}"
                            CommandParameter="SAND_GRAVITY" />
                    </Border.GestureRecognizers>

                    <Label
                        Text="SAND GRAVITY"
                        Style="{StaticResource AnimationTileLabelStyle}" />

                </Border>


                <!-- HEART -->
                <Border
                    Grid.Row="2"
                    Grid.Column="0"
                    Style="{StaticResource AnimationTileBorderStyle}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="13" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding SelectAnimationCommand}"
                            CommandParameter="HEART" />
                    </Border.GestureRecognizers>

                    <Label
                        Text="HEART"
                        Style="{StaticResource AnimationTileLabelStyle}" />

                </Border>


                <!-- RAIN -->
                <Border
                    Grid.Row="2"
                    Grid.Column="1"
                    Style="{StaticResource AnimationTileBorderStyle}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="13" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding SelectAnimationCommand}"
                            CommandParameter="RAIN" />
                    </Border.GestureRecognizers>

                    <Label
                        Text="RAIN"
                        Style="{StaticResource AnimationTileLabelStyle}" />

                </Border>


                <!-- WAVES -->
                <Border
                    Grid.Row="3"
                    Grid.Column="0"
                    Style="{StaticResource AnimationTileBorderStyle}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="13" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding SelectAnimationCommand}"
                            CommandParameter="WAVES" />
                    </Border.GestureRecognizers>

                    <Label
                        Text="WAVES"
                        Style="{StaticResource AnimationTileLabelStyle}" />

                </Border>

            </Grid>

            <!-- Dashboard status message -->
            <Label
                Text="{Binding DashboardMessage}"
                FontSize="11"
                TextColor="#7789A3" />

        </VerticalStackLayout>


        <!-- ======================================================== -->
        <!-- 6. FOOTER                                                -->
        <!-- ======================================================== -->
        <VerticalStackLayout
            Spacing="4"
            HorizontalOptions="Center"
            Margin="0,5,0,0">

            <!-- Application name -->
            <Label
                Text="EMOTIX360"
                FontSize="11"
                FontAttributes="Bold"
                CharacterSpacing="2"
                TextColor="#60748F"
                HorizontalTextAlignment="Center" />

            <!-- Application description -->
            <Label
                Text="Interactive Motion-Aware Display"
                FontSize="10"
                TextColor="#53657C"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

    </VerticalStackLayout>

</ContentView>