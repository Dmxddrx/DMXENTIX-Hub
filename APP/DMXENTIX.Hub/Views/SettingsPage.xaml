<?xml version="1.0" encoding="UTF-8" ?>

<ContentPage
    x:Class="DMXENTIX.Hub.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Settings"
    BackgroundColor="#0B111B"
    Shell.NavBarIsVisible="False">

    <!--
        SETTINGS PAGE STRUCTURE

        ContentPage
        │
        └─ ScrollView
           └─ VerticalStackLayout
              │
              ├─ Header
              │  ├─ Section title
              │  ├─ Settings heading
              │  └─ Description
              │
              ├─ Appearance
              │  └─ Application theme information
              │
              ├─ Device information
              │  ├─ Device name
              │  ├─ Hardware information
              │  └─ Connection type
              │
              ├─ Wi-Fi configuration
              │  │
              │  └─ Wi-Fi configuration card
              │     │
              │     ├─ Device connection status
              │     │
              │     ├─ Phone Wi-Fi
              │     │  ├─ Current phone SSID
              │     │  ├─ Refresh phone Wi-Fi button
              │     │  ├─ Use this network button
              │     │  └─ Permission information
              │     │
              │     ├─ Manual Wi-Fi credentials
              │     │  ├─ Network name (SSID)
              │     │  ├─ Wi-Fi password
              │     │  └─ Credential information
              │     │
              │     ├─ Stored network information
              │     │  └─ Saved app-sent network count
              │     │
              │     ├─ Wi-Fi credential operations
              │     │  ├─ Send Wi-Fi credentials button
              │     │  └─ Clear app-sent networks button
              │     │
              │     └─ Operation status message
              │
              ├─ Application information
              │  ├─ Application name
              │  ├─ Application version
              │  └─ Platform information
              │
              └─ Footer
                 ├─ Application name
                 └─ Application description

        NOTES:
- Wi-Fi configuration operations are controlled by SettingsViewModel.
- Phone Wi-Fi selection and manual credential entry are separate paths.
- App-sent network storage is managed independently from hardcoded
          firmware Wi-Fi credentials.
- ScrollView handles scrolling for the complete settings page.
    -->

    <!-- ============================================================ -->
    <!-- SCROLLVIEW (MAIN CONTENT)                                    -->
    <!-- ============================================================ -->
    <ScrollView>

        <VerticalStackLayout
            Padding="22,26,22,30"
            Spacing="22">

            <!-- ======================================================== -->
            <!-- 1. HEADER                                                -->
            <!-- ======================================================== -->
            <VerticalStackLayout Spacing="5">

                <!-- Section title -->
                <Label
                    Text="PREFERENCES"
                    FontSize="11"
                    CharacterSpacing="2"
                    FontAttributes="Bold"
                    TextColor="#5796FF" />

                <!-- Settings heading -->
                <Label
                    Text="Settings"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="#F2F5FC" />

                <!-- Description -->
                <Label
                    Text="Configure your DMXENTIX Hub preferences"
                    FontSize="14"
                    TextColor="#8999AF" />

            </VerticalStackLayout>


            <!-- ======================================================== -->
            <!-- 2. APPEARANCE                                            -->
            <!-- ======================================================== -->
            <VerticalStackLayout Spacing="12">

                <Label
                    Text="APPEARANCE"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    TextColor="#DFE7F3" />

                <!-- ── Application theme information ─────────────────── -->
                <Border
                    BackgroundColor="#121C2B"
                    Stroke="#26364A"
                    StrokeThickness="1"
                    Padding="17">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="Application theme"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#F2F5FC" />

                            <Label
                                Text="EMOTIX360 dark appearance"
                                FontSize="11"
                                TextColor="#8999AF" />

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="DARK"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="#78A8FF"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

            </VerticalStackLayout>

            <!-- ======================================================== -->
            <!-- 3. APPLICATION INFORMATION                               -->
            <!-- ======================================================== -->
            <VerticalStackLayout Spacing="12">

                <Label
                    Text="APPLICATION"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    TextColor="#DFE7F3" />

                <Border
                    BackgroundColor="#121C2B"
                    Stroke="#26364A"
                    StrokeThickness="1"
                    Padding="17">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="13">

                        <!-- ── Application name ──────────────────────────── -->
                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Application"
                                FontSize="13"
                                TextColor="#93A4BA" />

                            <Label
                                Grid.Column="1"
                                Text="EMOTIX360"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#F2F5FC" />

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="#26364A" />

                        <!-- ── Application version ───────────────────────── -->
                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Version"
                                FontSize="13"
                                TextColor="#93A4BA" />

                            <Label
                                Grid.Column="1"
                                Text="1.0"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#F2F5FC" />

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="#26364A" />

                        <!-- ── Platform information ──────────────────────── -->
                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Platform"
                                FontSize="13"
                                TextColor="#93A4BA" />

                            <Label
                                Grid.Column="1"
                                Text="Android"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#F2F5FC" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>


            <!-- ======================================================== -->
            <!-- 4. FOOTER                                                -->
            <!-- ======================================================== -->
            <VerticalStackLayout
                Spacing="5"
                HorizontalOptions="Center"
                Margin="0,10,0,0">

                <!-- Application name -->
                <Label
                    Text="EMOTIX360"
                    FontSize="13"
                    FontAttributes="Bold"
                    CharacterSpacing="2"
                    TextColor="#60748F"
                    HorizontalTextAlignment="Center" />

                <!-- Application description -->
                <Label
                    Text="Designed for intelligent interaction."
                    FontSize="10"
                    TextColor="#53657C"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>