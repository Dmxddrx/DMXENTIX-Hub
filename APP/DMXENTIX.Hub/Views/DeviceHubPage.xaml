<?xml version="1.0" encoding="UTF-8" ?>

<ContentPage
    x:Class="DMXENTIX.Hub.Views.DeviceHubPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Device Hub"
    BackgroundColor="#0B111B"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="22,26,22,30"
            Spacing="20">

            <!-- ================================================= -->
            <!-- HEADER                                            -->
            <!-- ================================================= -->

            <Grid ColumnDefinitions="*,Auto">

                <VerticalStackLayout Spacing="5">

                    <Label
                        Text="DEVICE MANAGER"
                        FontSize="11"
                        CharacterSpacing="2"
                        FontAttributes="Bold"
                        TextColor="#5796FF" />

                    <Label
                        Text="Devices"
                        FontSize="32"
                        FontAttributes="Bold"
                        TextColor="#F2F5FC" />

                    <Label
                        Text="Discover, connect and manage your devices."
                        FontSize="13"
                        TextColor="#8999AF" />

                </VerticalStackLayout>

                <Button
                    Grid.Column="1"
                    Text="{Binding MyDevicesButtonText}"
                    Command="{Binding OpenMyDevicesCommand}"
                    BackgroundColor="#1A2E49"
                    TextColor="#9EC2FF"
                    FontAttributes="Bold"
                    FontSize="10"
                    Padding="12,9"
                    CornerRadius="12"
                    VerticalOptions="Center" />

            </Grid>


            <!-- ================================================= -->
            <!-- BLUETOOTH / SCANNING                               -->
            <!-- ================================================= -->

            <Border
                BackgroundColor="#142135"
                Stroke="#263C58"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="11">

                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                            Text="DISCOVERY"
                            FontSize="11"
                            CharacterSpacing="1.2"
                            FontAttributes="Bold"
                            TextColor="#91A4BF" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding BluetoothStatusText}"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="#78A8FF" />

                    </Grid>

                    <Label
                        Text="{Binding StatusMessage}"
                        FontSize="13"
                        TextColor="#C0CCDD"
                        LineBreakMode="WordWrap" />

                    <Button
                        Text="{Binding ScanButtonText}"
                        Command="{Binding ScanCommand}"
                        IsEnabled="{Binding CanScan}"
                        BackgroundColor="#397FE8"
                        TextColor="White"
                        FontAttributes="Bold"
                        CharacterSpacing="0.8"
                        FontSize="12"
                        HeightRequest="49"
                        CornerRadius="13" />

                </VerticalStackLayout>

            </Border>


            <!-- ================================================= -->
            <!-- CONNECTED SESSIONS                                 -->
            <!-- ================================================= -->

            <VerticalStackLayout Spacing="12">

                <Grid ColumnDefinitions="*,Auto">

                    <Label
                        Text="CONNECTED SESSIONS"
                        FontSize="12"
                        CharacterSpacing="1"
                        FontAttributes="Bold"
                        TextColor="#DFE7F3" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding ConnectedSessionCountText}"
                        FontSize="11"
                        TextColor="#78A8FF" />

                </Grid>

                <Label
                    Text="No connected device sessions."
                    IsVisible="{Binding HasNoConnectedSessions}"
                    FontSize="12"
                    TextColor="#8999AF" />

                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding ConnectedSessions}"
                    Spacing="10">

                    <BindableLayout.ItemTemplate>

                        <DataTemplate>

                            <Border
                                BackgroundColor="#142B25"
                                Stroke="#285445"
                                StrokeThickness="1"
                                Padding="15">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15" />
                                </Border.StrokeShape>

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="10">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding ProductName}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="#F2F5FC" />

                                        <Label
                                            Text="{Binding DeviceName}"
                                            FontSize="11"
                                            TextColor="#A9BBAF" />

                                        <Label
                                            Text="CONNECTED"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="#72C9A0" />

                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Column="1"
                                        Text="SELECT"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectSessionCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#285445"
                                        TextColor="#A9F0CE"
                                        FontAttributes="Bold"
                                        FontSize="10"
                                        Padding="13,8"
                                        CornerRadius="10"
                                        VerticalOptions="Center" />

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>

            </VerticalStackLayout>


            <!-- ================================================= -->
            <!-- DISCOVERED DEVICES                                 -->
            <!-- ================================================= -->

            <VerticalStackLayout Spacing="12">

                <Grid ColumnDefinitions="*,Auto">

                    <Label
                        Text="NEARBY SUPPORTED DEVICES"
                        FontSize="12"
                        CharacterSpacing="1"
                        FontAttributes="Bold"
                        TextColor="#DFE7F3" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding DiscoveredDeviceCountText}"
                        FontSize="11"
                        TextColor="#7789A3" />

                </Grid>

                <Label
                    Text="{Binding NoDiscoveredDevicesText}"
                    IsVisible="{Binding HasNoDiscoveredDevices}"
                    FontSize="12"
                    TextColor="#8999AF" />

                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding DiscoveredDevices}"
                    Spacing="10">

                    <BindableLayout.ItemTemplate>

                        <DataTemplate>

                            <Border
                                BackgroundColor="#121C2B"
                                Stroke="#26364A"
                                StrokeThickness="1"
                                Padding="15">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15" />
                                </Border.StrokeShape>

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="10">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding ProductName}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="#F2F5FC" />

                                        <Label
                                            Text="{Binding AdvertisedName}"
                                            FontSize="11"
                                            TextColor="#8999AF" />

                                        <Label
                                            Text="{Binding DeviceType}"
                                            FontSize="10"
                                            TextColor="#7789A3" />

                                        <Label
                                            Text="{Binding Rssi, StringFormat='{}{0} dBm'}"
                                            FontSize="10"
                                            TextColor="#78A8FF" />

                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Column="1"
                                        Text="CONNECT"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ConnectDeviceCommand}"
                                        CommandParameter="{Binding .}"
                                        IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CanConnectDevices}"
                                        BackgroundColor="#397FE8"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="10"
                                        Padding="13,8"
                                        CornerRadius="10"
                                        VerticalOptions="Center" />

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>

            </VerticalStackLayout>


            <!-- ================================================= -->
            <!-- FOOTER                                            -->
            <!-- ================================================= -->

            <Label
                Text="Only devices identified by a registered product profile appear here."
                FontSize="11"
                TextColor="#677B94"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>