<?xml version="1.0" encoding="UTF-8" ?>

<ContentPage
    x:Class="DMXENTIX.Hub.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Home"
    BackgroundColor="#0B111B"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="22,30,22,30"
            Spacing="22">

            <!-- ================================================= -->
            <!-- HEADER                                            -->
            <!-- ================================================= -->

            <VerticalStackLayout Spacing="6">

                <Label
                    Text="DMXENTIX"
                    FontSize="12"
                    CharacterSpacing="3"
                    FontAttributes="Bold"
                    TextColor="#5796FF" />

                <Label
                    Text="Device Hub"
                    FontSize="34"
                    FontAttributes="Bold"
                    TextColor="#F2F5FC" />

                <Label
                    Text="Your connected engineering ecosystem."
                    FontSize="14"
                    TextColor="#8999AF" />

            </VerticalStackLayout>


            <!-- ================================================= -->
            <!-- DEVICE MANAGEMENT                                 -->
            <!-- ================================================= -->

            <Border
                BackgroundColor="#142135"
                Stroke="#263C58"
                StrokeThickness="1"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="13">

                    <Label
                        Text="DEVICE MANAGEMENT"
                        FontSize="11"
                        CharacterSpacing="1.5"
                        FontAttributes="Bold"
                        TextColor="#91A4BF" />

                    <Label
                        Text="Discover and manage your devices."
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#F2F5FC" />

                    <Label
                        Text="Connect supported products, monitor active BLE sessions and access their individual workspaces."
                        FontSize="13"
                        TextColor="#AAB8CB"
                        LineHeight="1.35" />

                    <Button
                        Text="OPEN DEVICE HUB"
                        Clicked="OnOpenDeviceHubClicked"
                        BackgroundColor="#397FE8"
                        TextColor="White"
                        FontAttributes="Bold"
                        CharacterSpacing="0.8"
                        FontSize="12"
                        HeightRequest="50"
                        CornerRadius="13" />

                    <Button
                        Text="VIEW MY DEVICES"
                        Clicked="OnOpenMyDevicesClicked"
                        BackgroundColor="#263C58"
                        TextColor="#DDE9FF"
                        FontAttributes="Bold"
                        FontSize="12"
                        HeightRequest="48"
                        CornerRadius="13" />

                </VerticalStackLayout>

            </Border>


            <!-- ================================================= -->
            <!-- DEVICE WORKSPACES                                 -->
            <!-- ================================================= -->

            <Border
                BackgroundColor="#121C2B"
                Stroke="#26364A"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="9">

                    <Label
                        Text="INDIVIDUAL WORKSPACES"
                        FontSize="11"
                        CharacterSpacing="1.3"
                        FontAttributes="Bold"
                        TextColor="#91A4BF" />

                    <Label
                        Text="One workspace for each product."
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#F2F5FC" />

                    <Label
                        Text="Select a saved device to access its product-specific dashboard, telemetry and configuration tools."
                        FontSize="12"
                        TextColor="#8999AF"
                        LineHeight="1.35" />

                </VerticalStackLayout>

            </Border>


            <!-- ================================================= -->
            <!-- FOOTER                                            -->
            <!-- ================================================= -->

            <VerticalStackLayout
                Spacing="4"
                HorizontalOptions="Center"
                Margin="0,8,0,0">

                <Label
                    Text="DMXENTIX HUB"
                    FontSize="10"
                    FontAttributes="Bold"
                    CharacterSpacing="2"
                    TextColor="#60748F"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Connected engineering ecosystem"
                    FontSize="10"
                    TextColor="#53657C"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
